# Opt in to sending recognized table text to this provider.
SPEECH_AI_ENABLED=false
# Also send code blocks for brief explanations. Requires SPEECH_AI_ENABLED=true.
SPEECH_AI_CODE_ENABLED=false
# Any provider implementing OpenAI-compatible chat completions.
SPEECH_AI_BASE_URL=https://api.openai.com/v1
SPEECH_AI_API_KEY=
SPEECH_AI_MODEL=

# Optional, only for providers/models supporting this chat-completions parameter.
# Lower reasoning can reduce narration latency; omit to use the provider default.
# SPEECH_AI_REASONING_EFFORT=none

# Optional Jev routing of fenced contents. Requires both AI settings above.
# Without classification, opted-in blocks are read verbatim with fences removed.
SPEECH_CLASSIFIER_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
